# ==========================================
# PlaceMentor - Production Environment Variables
# Copy this file to .env before starting containers:
#   cp .env.example .env
# DO NOT commit the actual .env file to Git!
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_DB=placementor_db
POSTGRES_USER=placementor
POSTGRES_PASSWORD=your_strong_postgres_password_here

# JWT Authentication Security Secret
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here

# CORS Configuration (Frontend Origin)
# For local docker testing: http://localhost
# For production EC2: http://<EC2-PUBLIC-IP> or https://<YOUR-DOMAIN>
CLIENT_URL=http://localhost
